# ============================================================================
# TULYA — configuration
# Copy to .env and edit. Nothing here has a production-safe default.
# ============================================================================

# ---- application ----------------------------------------------------------
ENVIRONMENT=development           # development | test | production
DEBUG=false
APP_VERSION=2.0.0

# ---- security -------------------------------------------------------------
# REQUIRED, minimum 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-this-must-be-at-least-32-characters-long
SESSION_TTL_SECONDS=43200
SESSION_COOKIE_SECURE=true        # must stay true in production (HTTPS only)
SESSION_COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:5173
LOGIN_RATE_LIMIT=10/minute

# Demo accounts (viewer/steward/approver/admin). The config validator REFUSES
# to start if this is true while ENVIRONMENT=production.
SEED_DEMO_USERS=true

# ---- database -------------------------------------------------------------
# docker compose: host is the service name `db`, not localhost
DATABASE_URL=postgresql+psycopg://tulya:tulya@db:5432/tulya
POSTGRES_USER=tulya
POSTGRES_PASSWORD=tulya
POSTGRES_DB=tulya

# ---- matching engine ------------------------------------------------------
# sbert is the production path. tfidf-svd exists only for machines with no
# model access and is REFUSED when MATCHING_STRICT is true.
EMBEDDING_BACKEND=sbert
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=256
VECTOR_INDEX=faiss-flatip         # faiss-flatip | numpy-exact
FUZZY_BACKEND=rapidfuzz           # rapidfuzz | difflib

# Leave unset to follow ENVIRONMENT (strict in production, permissive in dev).
# Set true on a dev machine to prove the real stack is being used.
# MATCHING_STRICT=true

# fusion weights and decision bands
W_COS=0.60
W_FUZ=0.25
W_ATTR=0.15
T_DISCARD=0.75
T_AUTO=0.92
MIN_COVERAGE=2
RETRIEVAL_TOPK=20

# ---- governance -----------------------------------------------------------
# rupees of stock at stake above which a merge needs a second, different approver
SECOND_APPROVAL_VALUE=1000000

# ---- local LLM: structured attribute extraction ONLY ----------------------
# Never consulted for an equivalence decision. Returns null for anything it
# cannot identify confidently; rule-based extraction is the fallback.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=30
