{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": "reports",
  "rewrites": [
    { "source": "/", "destination": "/tulya_console.html" }
  ],
  "headers": [
    {
      "source": "/tulya_console.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
